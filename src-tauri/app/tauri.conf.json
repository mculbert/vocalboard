{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vocalboard",
  "version": "0.1.0",
  "identifier": "com.vocalboard.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vocalboard",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: tauri:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
