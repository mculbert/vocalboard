{
  "name": "vocalboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm paraglide:compile && vite build",
    "preview": "vite preview",
    "check": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "pnpm paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "tauri": "tauri",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/i18n",
    "docs:api:frontend": "typedoc",
    "docs:api": "bash scripts/gen_api_docs.sh",
    "docs:build": "hugo --source docs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.9.1",
    "eslint": "^10.0.0",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "svelte": "^5.55.9",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.0.0",
    "typedoc": "^0.28.0",
    "typedoc-plugin-markdown": "^4.0.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.18.1",
    "@lucide/svelte": "^1.16.0",
    "@tauri-apps/api": "^2.11.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
